# App runtime variables.
# Set these in `.env.local` for local app runs and in Vercel Project Settings for production.
NEXT_PUBLIC_SUPABASE_URL=https://xenpsrdxdozzlszaktwa.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Local-only write key used by maintenance scripts such as `pnpm import:countries:write`.
# Do not add this to Vercel for the current public read-only deploy.
# Never expose this in the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_COUNTRY_IMPORT_KEY=replace-with-your-service-role-key
